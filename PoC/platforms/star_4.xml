<?xml version='1.0'?>
<!DOCTYPE platform SYSTEM "https://simgrid.org/simgrid.dtd">
<platform version="4.1">

  <!-- Star: 4 compute nodes connected to 1 central router -->
  <!-- Each node-to-router link = NIC (12.5 GBps, 100 ns) -->
  <!-- Route between any two nodes traverses 2 links (src NIC + dst NIC) -->

  <zone id="star" routing="Floyd">

    <!-- 4 compute hosts -->
    <host id="node-0" speed="2000Gf"/>
    <host id="node-1" speed="2000Gf"/>
    <host id="node-2" speed="2000Gf"/>
    <host id="node-3" speed="2000Gf"/>

    <!-- Central router (not a compute node) -->
    <host id="router-0" speed="1Gf"/>

    <!-- 4 NIC links (node-to-router) -->
    <link id="nic-0" bandwidth="12.5GBps" latency="100ns"/>
    <link id="nic-1" bandwidth="12.5GBps" latency="100ns"/>
    <link id="nic-2" bandwidth="12.5GBps" latency="100ns"/>
    <link id="nic-3" bandwidth="12.5GBps" latency="100ns"/>

    <!-- Direct routes: node <-> router -->
    <route src="node-0" dst="router-0"> <link_ctn id="nic-0"/> </route>
    <route src="node-1" dst="router-0"> <link_ctn id="nic-1"/> </route>
    <route src="node-2" dst="router-0"> <link_ctn id="nic-2"/> </route>
    <route src="node-3" dst="router-0"> <link_ctn id="nic-3"/> </route>

  </zone>
</platform>
