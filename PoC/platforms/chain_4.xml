<?xml version='1.0'?>
<!DOCTYPE platform SYSTEM "https://simgrid.org/simgrid.dtd">
<platform version="4.1">

  <!-- Chain: 4 nodes in a direct-connect chain -->
  <!-- Baseline comparison: no routers, direct node-to-node links -->
  <!-- Each link: 12.5 GBps, 100 ns (same BW as router experiments) -->
  <!-- Route 0->1: 1 hop. Route 0->3: 3 hops. -->

  <zone id="chain" routing="Floyd">

    <host id="node-0" speed="2000Gf"/>
    <host id="node-1" speed="2000Gf"/>
    <host id="node-2" speed="2000Gf"/>
    <host id="node-3" speed="2000Gf"/>

    <link id="link-01" bandwidth="12.5GBps" latency="100ns"/>
    <link id="link-12" bandwidth="12.5GBps" latency="100ns"/>
    <link id="link-23" bandwidth="12.5GBps" latency="100ns"/>

    <route src="node-0" dst="node-1"> <link_ctn id="link-01"/> </route>
    <route src="node-1" dst="node-2"> <link_ctn id="link-12"/> </route>
    <route src="node-2" dst="node-3"> <link_ctn id="link-23"/> </route>

  </zone>
</platform>
