<?xml version='1.0'?>
<!DOCTYPE platform SYSTEM "https://simgrid.org/simgrid.dtd">
<platform version="4.1">

  <!-- Dual Switch: 8 nodes, 2 switches, 1 uplink -->
  <!-- Nodes 0-3 on switch-0, nodes 4-7 on switch-1 -->
  <!-- NIC links: 12.5 GBps, 100 ns -->
  <!-- Uplink (switch-to-switch): 12.5 GBps, 100 ns -->
  <!-- Intra-switch: 2 hops (src NIC + dst NIC) -->
  <!-- Inter-switch: 3 hops (src NIC + uplink + dst NIC) -->

  <zone id="dual_switch" routing="Floyd">

    <!-- 8 compute hosts -->
    <host id="node-0" speed="2000Gf"/>
    <host id="node-1" speed="2000Gf"/>
    <host id="node-2" speed="2000Gf"/>
    <host id="node-3" speed="2000Gf"/>
    <host id="node-4" speed="2000Gf"/>
    <host id="node-5" speed="2000Gf"/>
    <host id="node-6" speed="2000Gf"/>
    <host id="node-7" speed="2000Gf"/>

    <!-- 2 switches -->
    <host id="switch-0" speed="1Gf"/>
    <host id="switch-1" speed="1Gf"/>

    <!-- NIC links: nodes to their local switch -->
    <link id="nic-0" bandwidth="12.5GBps" latency="100ns"/>
    <link id="nic-1" bandwidth="12.5GBps" latency="100ns"/>
    <link id="nic-2" bandwidth="12.5GBps" latency="100ns"/>
    <link id="nic-3" bandwidth="12.5GBps" latency="100ns"/>
    <link id="nic-4" bandwidth="12.5GBps" latency="100ns"/>
    <link id="nic-5" bandwidth="12.5GBps" latency="100ns"/>
    <link id="nic-6" bandwidth="12.5GBps" latency="100ns"/>
    <link id="nic-7" bandwidth="12.5GBps" latency="100ns"/>

    <!-- Uplink: switch-0 to switch-1 -->
    <link id="uplink" bandwidth="12.5GBps" latency="100ns"/>

    <!-- Routes: node <-> switch -->
    <route src="node-0" dst="switch-0"> <link_ctn id="nic-0"/> </route>
    <route src="node-1" dst="switch-0"> <link_ctn id="nic-1"/> </route>
    <route src="node-2" dst="switch-0"> <link_ctn id="nic-2"/> </route>
    <route src="node-3" dst="switch-0"> <link_ctn id="nic-3"/> </route>
    <route src="node-4" dst="switch-1"> <link_ctn id="nic-4"/> </route>
    <route src="node-5" dst="switch-1"> <link_ctn id="nic-5"/> </route>
    <route src="node-6" dst="switch-1"> <link_ctn id="nic-6"/> </route>
    <route src="node-7" dst="switch-1"> <link_ctn id="nic-7"/> </route>

    <!-- Route: switch <-> switch -->
    <route src="switch-0" dst="switch-1"> <link_ctn id="uplink"/> </route>

  </zone>
</platform>
