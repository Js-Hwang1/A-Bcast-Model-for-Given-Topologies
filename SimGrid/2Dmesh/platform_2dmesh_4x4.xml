<?xml version='1.0'?>
<!DOCTYPE platform SYSTEM "https://simgrid.org/simgrid.dtd">
<platform version="4.1">

  <!-- 4x4 2D Mesh (16 nodes, 24 links) -->

  <zone id="mesh2d" routing="Floyd">

    <!-- 16 hosts -->
    <host id="node-0" speed="2000Gf"/>
    <host id="node-1" speed="2000Gf"/>
    <host id="node-2" speed="2000Gf"/>
    <host id="node-3" speed="2000Gf"/>
    <host id="node-4" speed="2000Gf"/>
    <host id="node-5" speed="2000Gf"/>
    <host id="node-6" speed="2000Gf"/>
    <host id="node-7" speed="2000Gf"/>
    <host id="node-8" speed="2000Gf"/>
    <host id="node-9" speed="2000Gf"/>
    <host id="node-10" speed="2000Gf"/>
    <host id="node-11" speed="2000Gf"/>
    <host id="node-12" speed="2000Gf"/>
    <host id="node-13" speed="2000Gf"/>
    <host id="node-14" speed="2000Gf"/>
    <host id="node-15" speed="2000Gf"/>

    <!-- 12 horizontal links (InfiniBand NDR 400) -->
    <link id="link-0-1" bandwidth="50GBps" latency="500ns"/>
    <link id="link-1-2" bandwidth="50GBps" latency="500ns"/>
    <link id="link-2-3" bandwidth="50GBps" latency="500ns"/>
    <link id="link-4-5" bandwidth="50GBps" latency="500ns"/>
    <link id="link-5-6" bandwidth="50GBps" latency="500ns"/>
    <link id="link-6-7" bandwidth="50GBps" latency="500ns"/>
    <link id="link-8-9" bandwidth="50GBps" latency="500ns"/>
    <link id="link-9-10" bandwidth="50GBps" latency="500ns"/>
    <link id="link-10-11" bandwidth="50GBps" latency="500ns"/>
    <link id="link-12-13" bandwidth="50GBps" latency="500ns"/>
    <link id="link-13-14" bandwidth="50GBps" latency="500ns"/>
    <link id="link-14-15" bandwidth="50GBps" latency="500ns"/>

    <!-- 12 vertical links -->
    <link id="link-0-4" bandwidth="50GBps" latency="500ns"/>
    <link id="link-1-5" bandwidth="50GBps" latency="500ns"/>
    <link id="link-2-6" bandwidth="50GBps" latency="500ns"/>
    <link id="link-3-7" bandwidth="50GBps" latency="500ns"/>
    <link id="link-4-8" bandwidth="50GBps" latency="500ns"/>
    <link id="link-5-9" bandwidth="50GBps" latency="500ns"/>
    <link id="link-6-10" bandwidth="50GBps" latency="500ns"/>
    <link id="link-7-11" bandwidth="50GBps" latency="500ns"/>
    <link id="link-8-12" bandwidth="50GBps" latency="500ns"/>
    <link id="link-9-13" bandwidth="50GBps" latency="500ns"/>
    <link id="link-10-14" bandwidth="50GBps" latency="500ns"/>
    <link id="link-11-15" bandwidth="50GBps" latency="500ns"/>

    <!-- Direct neighbor routes (Floyd fills multi-hop) -->
    <route src="node-0" dst="node-1"> <link_ctn id="link-0-1"/> </route>
    <route src="node-1" dst="node-2"> <link_ctn id="link-1-2"/> </route>
    <route src="node-2" dst="node-3"> <link_ctn id="link-2-3"/> </route>
    <route src="node-4" dst="node-5"> <link_ctn id="link-4-5"/> </route>
    <route src="node-5" dst="node-6"> <link_ctn id="link-5-6"/> </route>
    <route src="node-6" dst="node-7"> <link_ctn id="link-6-7"/> </route>
    <route src="node-8" dst="node-9"> <link_ctn id="link-8-9"/> </route>
    <route src="node-9" dst="node-10"> <link_ctn id="link-9-10"/> </route>
    <route src="node-10" dst="node-11"> <link_ctn id="link-10-11"/> </route>
    <route src="node-12" dst="node-13"> <link_ctn id="link-12-13"/> </route>
    <route src="node-13" dst="node-14"> <link_ctn id="link-13-14"/> </route>
    <route src="node-14" dst="node-15"> <link_ctn id="link-14-15"/> </route>
    <route src="node-0" dst="node-4"> <link_ctn id="link-0-4"/> </route>
    <route src="node-1" dst="node-5"> <link_ctn id="link-1-5"/> </route>
    <route src="node-2" dst="node-6"> <link_ctn id="link-2-6"/> </route>
    <route src="node-3" dst="node-7"> <link_ctn id="link-3-7"/> </route>
    <route src="node-4" dst="node-8"> <link_ctn id="link-4-8"/> </route>
    <route src="node-5" dst="node-9"> <link_ctn id="link-5-9"/> </route>
    <route src="node-6" dst="node-10"> <link_ctn id="link-6-10"/> </route>
    <route src="node-7" dst="node-11"> <link_ctn id="link-7-11"/> </route>
    <route src="node-8" dst="node-12"> <link_ctn id="link-8-12"/> </route>
    <route src="node-9" dst="node-13"> <link_ctn id="link-9-13"/> </route>
    <route src="node-10" dst="node-14"> <link_ctn id="link-10-14"/> </route>
    <route src="node-11" dst="node-15"> <link_ctn id="link-11-15"/> </route>

  </zone>
</platform>
