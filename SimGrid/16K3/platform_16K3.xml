<?xml version='1.0'?>
<!DOCTYPE platform SYSTEM "https://simgrid.org/simgrid.dtd">
<platform version="4.1">

  <!--
    16K3 Topology: 16-node 3-regular graph (full-duplex)
    24 undirected edges. Floyd routing computes shortest paths.

    Hardware model: InfiniBand NDR 400 interconnect
      - Per-port bandwidth : 400 Gbps = 50 GB/s per direction
      - Port-to-port latency: ~500 ns (includes NIC + wire + switch cut-through)
      - Switch cut-through   : ~90 ns
    Compute nodes: modern HPC (e.g. AMD EPYC Genoa / Intel Sapphire Rapids)
      - ~2 TFlop/s per node (broadcast is communication-bound, value is symbolic)

    Adjacency (0-indexed):
      0: [1, 2, 3]       1: [0, 6, 10]      2: [0, 8, 12]      3: [0, 4, 14]
      4: [3, 5, 9]       5: [4, 6, 11]      6: [1, 5, 7]       7: [6, 8, 13]
      8: [2, 7, 9]       9: [4, 8, 15]     10: [1, 11, 15]    11: [5, 10, 12]
     12: [2, 11, 13]    13: [7, 12, 14]    14: [3, 13, 15]    15: [9, 10, 14]
  -->

  <!-- =================================================================
       SMPI / Network model configuration
       Use the IB model for InfiniBand-specific contention modeling.
       IB penalty factors (βe, βs, γs) govern bandwidth degradation
       when multiple flows share ingress/egress ports.
       ================================================================= -->
  <config>
    <prop id="network/model" value="IB"/>
    <!-- βe=0.965 (ingress penalty), βs=0.925 (egress penalty),
         γs=1.35  (saturation slow-down factor)
         Default values from Stampede calibration; refine with
         target-cluster measurements for publication-grade results. -->
    <prop id="smpi/IB-penalty-factors" value="0.965;0.925;1.35"/>
  </config>

  <zone id="16K3" routing="Floyd">

    <!-- ============================================================
         Hosts: 16 compute nodes
         2 TFlop/s per node — symbolic for a communication study.
         ============================================================ -->
    <host id="node-0"  speed="2000Gf"/>
    <host id="node-1"  speed="2000Gf"/>
    <host id="node-2"  speed="2000Gf"/>
    <host id="node-3"  speed="2000Gf"/>
    <host id="node-4"  speed="2000Gf"/>
    <host id="node-5"  speed="2000Gf"/>
    <host id="node-6"  speed="2000Gf"/>
    <host id="node-7"  speed="2000Gf"/>
    <host id="node-8"  speed="2000Gf"/>
    <host id="node-9"  speed="2000Gf"/>
    <host id="node-10" speed="2000Gf"/>
    <host id="node-11" speed="2000Gf"/>
    <host id="node-12" speed="2000Gf"/>
    <host id="node-13" speed="2000Gf"/>
    <host id="node-14" speed="2000Gf"/>
    <host id="node-15" speed="2000Gf"/>

    <!-- ============================================================
         Links: 24 edges of the 3-regular graph.
         InfiniBand NDR 400: 50 GB/s per direction, 500 ns latency.
         Full-duplex: SimGrid's IB model handles bidirectional
         traffic with contention natively — no half-duplex constraint.
         ============================================================ -->

    <!-- Edges from node 0 (degree 3) -->
    <link id="link-0-1"  bandwidth="50GBps" latency="500ns"/>
    <link id="link-0-2"  bandwidth="50GBps" latency="500ns"/>
    <link id="link-0-3"  bandwidth="50GBps" latency="500ns"/>

    <!-- Edges from node 1 (remaining) -->
    <link id="link-1-6"  bandwidth="50GBps" latency="500ns"/>
    <link id="link-1-10" bandwidth="50GBps" latency="500ns"/>

    <!-- Edges from node 2 (remaining) -->
    <link id="link-2-8"  bandwidth="50GBps" latency="500ns"/>
    <link id="link-2-12" bandwidth="50GBps" latency="500ns"/>

    <!-- Edges from node 3 (remaining) -->
    <link id="link-3-4"  bandwidth="50GBps" latency="500ns"/>
    <link id="link-3-14" bandwidth="50GBps" latency="500ns"/>

    <!-- Edges from node 4 (remaining) -->
    <link id="link-4-5"  bandwidth="50GBps" latency="500ns"/>
    <link id="link-4-9"  bandwidth="50GBps" latency="500ns"/>

    <!-- Edges from node 5 (remaining) -->
    <link id="link-5-6"  bandwidth="50GBps" latency="500ns"/>
    <link id="link-5-11" bandwidth="50GBps" latency="500ns"/>

    <!-- Edges from node 6 (remaining) -->
    <link id="link-6-7"  bandwidth="50GBps" latency="500ns"/>

    <!-- Edges from node 7 (remaining) -->
    <link id="link-7-8"  bandwidth="50GBps" latency="500ns"/>
    <link id="link-7-13" bandwidth="50GBps" latency="500ns"/>

    <!-- Edges from node 8 (remaining) -->
    <link id="link-8-9"  bandwidth="50GBps" latency="500ns"/>

    <!-- Edges from node 9 (remaining) -->
    <link id="link-9-15" bandwidth="50GBps" latency="500ns"/>

    <!-- Edges from node 10 (remaining) -->
    <link id="link-10-11" bandwidth="50GBps" latency="500ns"/>
    <link id="link-10-15" bandwidth="50GBps" latency="500ns"/>

    <!-- Edges from node 11 (remaining) -->
    <link id="link-11-12" bandwidth="50GBps" latency="500ns"/>

    <!-- Edges from node 12 (remaining) -->
    <link id="link-12-13" bandwidth="50GBps" latency="500ns"/>

    <!-- Edges from node 13 (remaining) -->
    <link id="link-13-14" bandwidth="50GBps" latency="500ns"/>

    <!-- Edges from node 14 (remaining) -->
    <link id="link-14-15" bandwidth="50GBps" latency="500ns"/>

    <!-- ============================================================
         Routes: direct neighbor connections only.
         Floyd routing derives all multi-hop shortest paths.
         ============================================================ -->

    <!-- Node 0 -->
    <route src="node-0" dst="node-1">  <link_ctn id="link-0-1"/>  </route>
    <route src="node-0" dst="node-2">  <link_ctn id="link-0-2"/>  </route>
    <route src="node-0" dst="node-3">  <link_ctn id="link-0-3"/>  </route>

    <!-- Node 1 -->
    <route src="node-1" dst="node-6">  <link_ctn id="link-1-6"/>  </route>
    <route src="node-1" dst="node-10"> <link_ctn id="link-1-10"/> </route>

    <!-- Node 2 -->
    <route src="node-2" dst="node-8">  <link_ctn id="link-2-8"/>  </route>
    <route src="node-2" dst="node-12"> <link_ctn id="link-2-12"/> </route>

    <!-- Node 3 -->
    <route src="node-3" dst="node-4">  <link_ctn id="link-3-4"/>  </route>
    <route src="node-3" dst="node-14"> <link_ctn id="link-3-14"/> </route>

    <!-- Node 4 -->
    <route src="node-4" dst="node-5">  <link_ctn id="link-4-5"/>  </route>
    <route src="node-4" dst="node-9">  <link_ctn id="link-4-9"/>  </route>

    <!-- Node 5 -->
    <route src="node-5" dst="node-6">  <link_ctn id="link-5-6"/>  </route>
    <route src="node-5" dst="node-11"> <link_ctn id="link-5-11"/> </route>

    <!-- Node 6 -->
    <route src="node-6" dst="node-7">  <link_ctn id="link-6-7"/>  </route>

    <!-- Node 7 -->
    <route src="node-7" dst="node-8">  <link_ctn id="link-7-8"/>  </route>
    <route src="node-7" dst="node-13"> <link_ctn id="link-7-13"/> </route>

    <!-- Node 8 -->
    <route src="node-8" dst="node-9">  <link_ctn id="link-8-9"/>  </route>

    <!-- Node 9 -->
    <route src="node-9" dst="node-15"> <link_ctn id="link-9-15"/> </route>

    <!-- Node 10 -->
    <route src="node-10" dst="node-11"> <link_ctn id="link-10-11"/> </route>
    <route src="node-10" dst="node-15"> <link_ctn id="link-10-15"/> </route>

    <!-- Node 11 -->
    <route src="node-11" dst="node-12"> <link_ctn id="link-11-12"/> </route>

    <!-- Node 12 -->
    <route src="node-12" dst="node-13"> <link_ctn id="link-12-13"/> </route>

    <!-- Node 13 -->
    <route src="node-13" dst="node-14"> <link_ctn id="link-13-14"/> </route>

    <!-- Node 14 -->
    <route src="node-14" dst="node-15"> <link_ctn id="link-14-15"/> </route>

  </zone>
</platform>
