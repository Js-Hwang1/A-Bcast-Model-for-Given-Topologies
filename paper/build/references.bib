@InProceedings{10.1007/978-3-540-30218-6_28,
author="Tr{\"a}ff, Jesper Larsson",
editor="Kranzlm{\"u}ller, Dieter
and Kacsuk, P{\'e}ter
and Dongarra, Jack",
title="A Simple Work-Optimal Broadcast Algorithm for Message-Passing Parallel Systems",
booktitle="Recent Advances in Parallel Virtual Machine and Message Passing Interface",
year="2004",
publisher="Springer Berlin Heidelberg",
address="Berlin, Heidelberg",
pages="173--180",
abstract="In this note we give a simple bandwidth- and latency optimal algorithm for the problem of broadcasting m units of data from a distinguished root processor to all p--1 other processors in one-ported (hypercubic) message-passing systems. Assuming linear, uniform communication cost, the time for the broadcast to complete is O(m+log2p), more precisely no processor is involved in more than ⌈log2p⌉ communication operations (send, receive, and send-receive), and for any constant message size thresholdb each processor (except the root) sends at most m--b{\textasciiacutex}+( ⌈log2p⌉--ℓ)b{\textasciiacutex} units of data, where b{\textasciiacutex} is determined by the smallest ℓ≤ ⌈log2p⌉ such that b{\textasciiacutex}=m/2ℓ≤ b (the root sends 2m--b{\textasciiacutex}+( ⌈log2p⌉ --ℓ)b{\textasciiacutex} units of data). Non-root processors receive m units of data.",
isbn="978-3-540-30218-6"
}

