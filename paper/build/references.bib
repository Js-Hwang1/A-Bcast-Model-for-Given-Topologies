@article{SMPI,
author = {Degomme, Augustin and Legrand, Arnaud and Markomanolis, George S. and Quinson, Martin and Stillwell, Mark and Suter, Fr\'{e}d\'{e}ric},
title = {Simulating MPI Applications: The SMPI Approach},
