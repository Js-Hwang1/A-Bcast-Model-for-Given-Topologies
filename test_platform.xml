<?xml version='1.0'?>
<!DOCTYPE platform SYSTEM "https://simgrid.org/simgrid.dtd">
<platform version="4.1">
  <!-- Simple 3-node chain: 0 -- 1 -- 2 -->
  <!-- Single link between 1 and 2 to test bandwidth sharing -->
  <zone id="chain" routing="Full">
    <host id="node-0" speed="2000Gf"/>
    <host id="node-1" speed="2000Gf"/>
    <host id="node-2" speed="2000Gf"/>

    <link id="link-0-1" bandwidth="10GBps" latency="100ns"/>
    <link id="link-1-2" bandwidth="10GBps" latency="100ns"/>

    <route src="node-0" dst="node-1"> <link_ctn id="link-0-1"/> </route>
    <route src="node-1" dst="node-2"> <link_ctn id="link-1-2"/> </route>
    <route src="node-0" dst="node-2"> <link_ctn id="link-0-1"/> <link_ctn id="link-1-2"/> </route>
  </zone>
</platform>
